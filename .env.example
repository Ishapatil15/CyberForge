# Application
APP_NAME=CyberForge
SECRET_KEY=cyberforge-super-secure-production-secret-key-32chars
FLAG_PEPPER=cyberforge-flag-pepper-secret-hmac-sha256
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173

# Database (docker-compose default)
DATABASE_URL=postgresql+psycopg://ctf:ctf@localhost:5432/ctf

# First admin (used by seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.ctf
ADMIN_PASSWORD=ChangeMeAdmin!23

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Rate limits
LOGIN_RATE_LIMIT=8/minute
SUBMIT_RATE_LIMIT=20/minute
